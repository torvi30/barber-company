# ==========================================
# BarberPulse OS - Production GitIgnore
# Optimized for Ubuntu Linux / Node.js / React Vite
# ==========================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build Outputs & Production Bundles
dist/
dist-ssr/
build/
out/
*.local

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.pem
serviceAccountKey.json
firebase-credentials.json

# Cache & Temporary Directories
.firebase/
.cache/
.vite/
.npm/
.eslintcache
.stylelintcache
*.tsbuildinfo

# Runtime Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Linux & Operating System Artifacts
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
*~
*.swp
*.swo

# IDE & Editor Specific Files
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace

# Testing & Coverage
coverage/
.nyc_output/

# Socket & IPC Files
*.sock

