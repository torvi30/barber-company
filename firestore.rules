rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funciones de validación de autenticación y roles jerárquicos
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in ['victortamayopine@gmail.com', 'victortamayopinc@gmail.com', 'danielb.alzate1@gmail.com'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'superadmin')
      );
    }

    function isCompanyAdmin(companyId) {
      return isSuperAdmin() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'admin' &&
        getUserData().companyId == companyId
      );
    }

    function isCompanyEmployee(companyId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (getUserData().role in ['barbero', 'empleado']) &&
        getUserData().companyId == companyId;
    }

    // --- 1. COLECCIÓN DE USUARIOS (MULTI-TENANT ROLES) ---
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    // --- 2. COLECCIÓN DE EMPRESAS / BARBERÍAS ---
    match /barbershops/{barbershopId} {
      // Lectura pública de identidad de la barbería (nombre, logo, dirección)
      allow read: if true;
      // Escritura restringida al admin de la empresa o superadmin
      allow write: if isCompanyAdmin(barbershopId);

      // Subcolección de Barberos / Empleados
      match /barbers/{barberId} {
        // Lectura pública para que clientes vean quién atiende
        allow read: if true;
        // Admin de la empresa puede crear/editar/eliminar sus empleados
        // Un barbero puede actualizar su propio perfil (cambiar estado libre/pausa)
        // Permite auto-onboarding público desde link compartido
        allow write: if isCompanyAdmin(barbershopId) ||
          (isCompanyEmployee(barbershopId) && (getUserData().barberId == barberId || barberId == request.auth.uid)) ||
          !isAuthenticated();
      }

      // Subcolección de Citas / Agenda
      match /appointments/{appointmentId} {
        // Clientes públicos y barberos pueden reservar y consultar disponibilidad
        allow read, write: if true;
      }

      // Subcolección de Inventario y Tienda
      match /inventory/{itemId} {
        allow read: if isCompanyAdmin(barbershopId) || isCompanyEmployee(barbershopId);
        allow write: if isCompanyAdmin(barbershopId);
      }

      // Subcolección de Clientes CRM
      match /clients/{clientId} {
        allow read: if isCompanyAdmin(barbershopId) || isCompanyEmployee(barbershopId);
        allow write: if isCompanyAdmin(barbershopId);
      }

      // Subcolección de Cajas y Cierres Diarios (CONFIDENCIAL: Solo Admin y Superadmin)
      match /cash_closures/{closureId} {
        allow read, write: if isCompanyAdmin(barbershopId);
      }

      // Subcolección de Movimientos de Caja (CONFIDENCIAL: Solo Admin y Superadmin)
      match /cash_movements/{movementId} {
        allow read, write: if isCompanyAdmin(barbershopId);
      }
    }
  }
}
